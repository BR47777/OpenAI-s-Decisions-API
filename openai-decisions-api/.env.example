# Use OpenAI directly
OPENAI_API_KEY=
DECISIONS_API_URL=https://api.openai.com/v1/decisions
DECISIONS_MODEL=gpt-6-luna

# Or use AI Gateway
# AI_GATEWAY_API_KEY=
# DECISIONS_API_URL=https://ai-gateway.vercel.sh/v1/decisions
# DECISIONS_MODEL=openai/gpt-6-luna-decisions

# Set to 1 to call the configured API instead of the local evaluator.
DECISIONS_LIVE=0
